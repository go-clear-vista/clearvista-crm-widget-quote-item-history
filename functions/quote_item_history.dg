string automation.quote_item_history(String quote_id)
{
	// Backend for the Item History widget (launched from a sales quote).
	// Return type String; ONE argument, quote_id (String), carrying either:
	//   a quote record id       - the line items are derived from the quote
	//   "rows=<id,id,...>"      - Quoted_Items ROW ids, which resolve back to
	//                             the quote, giving the header details too
	//   "products=<id,id,...>"  - CRM product record ids, the last resort when
	//                             neither the quote nor its row ids are
	//                             readable; no quote number or account then
	// One argument, not two, because Zoho saves a function's argument list and
	// its code together: a new argument will not register until the code
	// compiles, and the code cannot compile until it is registered.
	// The category word on line 1 must match this function's Category in CRM.
	//
	// Returns a JSON string: success, quote, items, rows, warnings.
	// item_price is the per-unit list price; total_after_discount is the
	// discounted EXTENDED total. The widget derives the per-unit price as
	// total_after_discount / quantity, because the stored item price is
	// sometimes a pre-discount list price (see CLAUDE.md).
	//
	// COQL connection: "crm_api_v21" - needs scope ZohoCRM.coql.READ, and is
	//   used to query the Quoted_Items subform module across all quotes. Deluge
	//   requires a LITERAL connection link name on an invokeurl, so if the
	//   connection is renamed, update all four invokeurl blocks below by hand.
	// Analytics connection: "zohoanalytics" - needs scope
	//   ZohoAnalytics.data.read. Zoho Books sales orders and invoices are read
	//   from the Analytics workspace that syncs from Books, not the Books API.
	//   Also a LITERAL link name, on the three Analytics invokeurl blocks.
	// ANALYTICS_ORG_ID / ANALYTICS_WORKSPACE_ID - the Analytics org and the
	//   "Zoho Analytics All" workspace. Set either to "" to run against CRM
	//   sales quotes only; the widget says so in a banner.
	// Neither failure is fatal - the widget renders whatever it could load.
	ANALYTICS_ORG_ID = "787402905";
	ANALYTICS_WORKSPACE_ID = "2604071000000006002";
	MAX_ANALYTICS_ROWS = 3000;

	result = Map();
	rows = List();
	items = List();
	warnings = List();

	identifier = "";
	if(quote_id != null)
	{
		identifier = quote_id.trim();
	}
	if(identifier == "")
	{
		result.put("success",false);
		result.put("message","Missing quote_id.");
		return result.toString();
	}

	// Which form the identifier takes. A record id is all digits, so the
	// "products=" prefix is unambiguous.
	quoteRecordId = "";
	suppliedProductIds = "";
	suppliedRowIds = "";
	if(identifier.startsWith("products="))
	{
		suppliedProductIds = identifier.subString(9,identifier.length()).trim();
	}
	else if(identifier.startsWith("rows="))
	{
		suppliedRowIds = identifier.subString(5,identifier.length()).trim();
	}
	else
	{
		quoteRecordId = identifier;
	}

	// Row ids resolve back to their parent quote, which recovers the quote
	// number and account that "products=" alone cannot supply.
	if(suppliedRowIds != "")
	{
		try
		{
			rowClause = "";
			for each rawRowId in suppliedRowIds.toList(",")
			{
				trimmedRowId = rawRowId.trim();
				if(trimmedRowId != "")
				{
					if(rowClause != "")
					{
						rowClause = rowClause + ",";
					}
					rowClause = rowClause + "'" + trimmedRowId + "'";
				}
			}
			if(rowClause != "")
			{
				rowCoql = "select Parent_Id from Quoted_Items where id in (" + rowClause + ") limit 0, 200";
				rowBody = Map();
				rowBody.put("select_query",rowCoql);
				rowResp = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:rowBody.toString()
					connection:"crm_api_v21"
				];
				for each rowLine in ifnull(rowResp.get("data"),List())
				{
					rowParent = rowLine.get("Parent_Id");
					if(rowParent != null)
					{
						candidateId = ifnull(rowParent.get("id"),"").toString();
						if(candidateId != "")
						{
							quoteRecordId = candidateId;
							break;
						}
					}
				}
			}
			if(quoteRecordId == "")
			{
				warnings.add("The quote could not be identified from its line item row ids.");
			}
		}
		catch (e)
		{
			warnings.add("Resolving the quote from its line item rows failed: " + e.toString());
		}
	}

	// ---- 1. the quote this widget was launched from ---------------------
	// Optional: the edit layout can read the subform but not the quote record,
	// so the caller may pass product ids with no quote id at all.
	quoteNumber = "";
	quoteAccount = "";
	quoteSubject = "";

	if(quoteRecordId != "")
	{
		quote = zoho.crm.getRecordById("Quotes",quoteRecordId.toLong());
		if(quote == null || !quote.containKey("id"))
		{
			warnings.add("Quote record " + quoteRecordId + " could not be read, so the header details are missing.");
		}
		else
		{
			// CRM_Quote_Number is the "SQ-101074" style number. Quote_Number is
			// a long record-id-like value, so it is deliberately not a fallback.
			quoteNumber = ifnull(quote.get("CRM_Quote_Number"),"").toString();
			if(quote.get("Account_Name") != null)
			{
				quoteAccount = ifnull(quote.get("Account_Name").get("name"),"").toString();
			}
			quoteSubject = ifnull(quote.get("Subject"),"").toString();
		}
	}

	// ---- 2. the items on this quote drive the Item Name checklist --------
	// getRecordById returns the quote's own fields but NOT its subform rows, so
	// read the line items over COQL - the same path the history below uses.
	productIds = List();
	skuById = Map();

	if(suppliedProductIds != "")
	{
		for each rawProductId in suppliedProductIds.toList(",")
		{
			suppliedId = rawProductId.trim();
			if(suppliedId != "" && !productIds.contains(suppliedId))
			{
				productIds.add(suppliedId);
			}
		}
	}
	else
	{
		try
		{
			ownCoql = "select Product_Name from Quoted_Items where Parent_Id = '" + quoteRecordId + "' limit 0, 200";
			ownBody = Map();
			ownBody.put("select_query",ownCoql);
			ownResp = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v7/coql"
				type :POST
				parameters:ownBody.toString()
				connection:"crm_api_v21"
			];
			ownData = ownResp.get("data");
			if(ownData == null)
			{
				warnings.add("The Quoted_Items query returned no data. CRM replied: " + ownResp.toString());
			}
			for each ownLine in ifnull(ownData,List())
			{
				product = ownLine.get("Product_Name");
				if(product == null)
				{
					continue;
				}
				productId = ifnull(product.get("id"),"").toString();
				sku = ifnull(product.get("name"),"").toString();
				if(productId == "" || sku == "")
				{
					continue;
				}
				if(!productIds.contains(productId))
				{
					productIds.add(productId);
					skuById.put(productId,sku);
				}
				if(!items.contains(sku))
				{
					items.add(sku);
				}
			}
		}
		catch (e)
		{
			warnings.add("The line items on this quote could not be read - check the crm_api_v21 connection: " + e.toString());
		}
	}

	if(productIds.size() > 0)
	{
		idClause = "";
		for each productId in productIds
		{
			if(idClause != "")
			{
				idClause = idClause + ",";
			}
			idClause = idClause + "'" + productId + "'";
		}

		// ---- 3. CRM sales quote history (COQL over Quoted_Items) --------
		quoteLines = List();
		parentIds = List();
		crmLoaded = false;

		// Deluge has no while loop, so page through a fixed list of offsets.
		// 10 pages x 200 rows caps this at 2000 quote line items.
		pageOffsets = List();
		pageOffsets.add(0);
		pageOffsets.add(200);
		pageOffsets.add(400);
		pageOffsets.add(600);
		pageOffsets.add(800);
		pageOffsets.add(1000);
		pageOffsets.add(1200);
		pageOffsets.add(1400);
		pageOffsets.add(1600);
		pageOffsets.add(1800);

		try
		{
			morePages = true;
			for each pageOffset in pageOffsets
			{
				if(!morePages)
				{
					continue;
				}
				coql = "select Parent_Id, Product_Name, Description, Item_Notes, Quantity, List_Price, Discount, Total, Total_After_Discount from Quoted_Items where Product_Name in (" + idClause + ") limit " + pageOffset + ", 200";
				body = Map();
				body.put("select_query",coql);
				response = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:body.toString()
					connection:"crm_api_v21"
				];
				pageData = response.get("data");
				if(pageData == null && pageOffset == 0)
				{
					warnings.add("The item history query returned no data. CRM replied: " + response.toString());
				}
				for each line in ifnull(pageData,List())
				{
					quoteLines.add(line);
					parent = line.get("Parent_Id");
					if(parent != null)
					{
						parentId = ifnull(parent.get("id"),"").toString();
						if(parentId != "" && !parentIds.contains(parentId))
						{
							parentIds.add(parentId);
						}
					}
				}
				morePages = false;
				info = response.get("info");
				if(info != null && ifnull(info.get("more_records"),false) == true)
				{
					morePages = true;
				}
			}
			crmLoaded = true;
		}
		catch (e)
		{
			warnings.add("Sales quote history could not be loaded - check the crm_api_v21 connection: " + e.toString());
		}

		// ---- 3b. parent quote headers, in batches of 100 ----------------
		quoteHeaders = Map();
		if(crmLoaded && parentIds.size() > 0)
		{
			try
			{
				seen = 0;
				total = parentIds.size();
				batch = List();
				for each parentId in parentIds
				{
					batch.add(parentId);
					seen = seen + 1;
					if(batch.size() == 100 || seen == total)
					{
						batchClause = "";
						for each batchId in batch
						{
							if(batchClause != "")
							{
								batchClause = batchClause + ",";
							}
							batchClause = batchClause + "'" + batchId + "'";
						}
						headerCoql = "select id, CRM_Quote_Number, Quote_Stage, Account_Name, Date_created_on_document, Created_Time from Quotes where id in (" + batchClause + ") limit 0, 200";
						headerBody = Map();
						headerBody.put("select_query",headerCoql);
						headerResp = invokeurl
						[
							url :"https://www.zohoapis.com/crm/v7/coql"
							type :POST
							parameters:headerBody.toString()
							connection:"crm_api_v21"
						];
						headerData = headerResp.get("data");
						if(headerData == null)
						{
							warnings.add("The quote header query returned no data. CRM replied: " + headerResp.toString());
						}
						for each record in ifnull(headerData,List())
						{
							recordId = ifnull(record.get("id"),"").toString();
							if(recordId == "")
							{
								continue;
							}
							documentDate = ifnull(record.get("Date_created_on_document"),"").toString();
							if(documentDate == "")
							{
								// Created_Time is an ISO timestamp - keep the date only.
								documentDate = ifnull(record.get("Created_Time"),"").toString();
								if(documentDate.length() >= 10)
								{
									documentDate = documentDate.subString(0,10);
								}
							}
							headerAccount = "";
							if(record.get("Account_Name") != null)
							{
								headerAccount = ifnull(record.get("Account_Name").get("name"),"").toString();
							}
							header = Map();
							header.put("quote_number",ifnull(record.get("CRM_Quote_Number"),"").toString());
							header.put("status",ifnull(record.get("Quote_Stage"),"").toString());
							header.put("account_name",headerAccount);
							header.put("date",documentDate);
							quoteHeaders.put(recordId,header);
						}
						batch = List();
					}
				}
			}
			catch (e)
			{
				warnings.add("Quote header details could not be loaded: " + e.toString());
			}
		}

		for each line in quoteLines
		{
			product = line.get("Product_Name");
			if(product == null)
			{
				continue;
			}
			lineSku = ifnull(product.get("name"),"").toString();
			lineProductId = ifnull(product.get("id"),"").toString();
			if(lineProductId != "" && lineSku != "" && ifnull(skuById.get(lineProductId),"") == "")
			{
				skuById.put(lineProductId,lineSku);
			}
			if(lineSku != "" && productIds.contains(lineProductId) && !items.contains(lineSku))
			{
				items.add(lineSku);
			}
			parent = line.get("Parent_Id");
			parentId = "";
			parentName = "";
			if(parent != null)
			{
				parentId = ifnull(parent.get("id"),"").toString();
				parentName = ifnull(parent.get("name"),"").toString();
			}
			header = ifnull(quoteHeaders.get(parentId),Map());

			row = Map();
			row.put("item_name",lineSku);
			row.put("description",ifnull(line.get("Description"),""));
			row.put("item_notes",ifnull(line.get("Item_Notes"),""));
			row.put("doc_type","Sales Quote");
			row.put("doc_number",ifnull(header.get("quote_number"),parentName));
			row.put("date",ifnull(header.get("date"),""));
			row.put("account_name",ifnull(header.get("account_name"),""));
			row.put("status",ifnull(header.get("status"),""));
			row.put("quantity",ifnull(line.get("Quantity"),0));
			row.put("item_price",ifnull(line.get("List_Price"),0));
			row.put("discount",ifnull(line.get("Discount"),0));
			row.put("line_total",ifnull(line.get("Total"),0));
			row.put("total_after_discount",ifnull(line.get("Total_After_Discount"),0));
			rows.add(row);
		}

		// ---- 4. Zoho Books sales orders and invoices, via Zoho Analytics ----
		// Books data is read from the Analytics workspace that syncs from Books
		// rather than from the Books API: a handful of small reads replace the
		// hundreds of per-item / per-document Books calls, and the data is only as
		// stale as the Analytics sync (acceptable for Books documents; CRM stays live).
		if(ANALYTICS_ORG_ID == "" || ANALYTICS_WORKSPACE_ID == "")
		{
			warnings.add("Zoho Books sales orders and invoices are not included: set ANALYTICS_ORG_ID and ANALYTICS_WORKSPACE_ID in the quote_item_history function.");
		}
		else
		{
			// The Analytics "Item Name" is the Books SKU, which is the CRM
			// Product_Code - NOT always the Product_Name (e.g. name "4-Series(R)
			// Media Presentation Controller 102", code "MPC4-102-B"). Read the
			// codes in one COQL call, and remember code -> CRM name so the rows
			// carry the name the widget's Item Name checklist knows.
			codeToName = Map();
			skuClause = "";
			try
			{
				codeCoql = "select id, Product_Name, Product_Code from Products where id in (" + idClause + ") limit 0, 200";
				codeBody = Map();
				codeBody.put("select_query",codeCoql);
				codeResp = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:codeBody.toString()
					connection:"crm_api_v21"
				];
				for each productRow in ifnull(codeResp.get("data"),List())
				{
					productName = ifnull(productRow.get("Product_Name"),"").toString();
					searchSku = ifnull(productRow.get("Product_Code"),"").toString().trim();
					if(searchSku == "")
					{
						searchSku = productName.trim();
					}
					if(searchSku == "" || codeToName.containKey(searchSku.toLowerCase()))
					{
						continue;
					}
					codeToName.put(searchSku.toLowerCase(),productName);
					if(skuClause != "")
					{
						skuClause = skuClause + ",";
					}
					skuClause = skuClause + "'" + searchSku.replaceAll("'","''") + "'";
				}
			}
			catch (e)
			{
				warnings.add("Product codes could not be read, so Books history was not searched: " + e.toString());
			}

			// Analytics' synchronous export API is used, NOT the bulk (SQL) export:
			// bulk jobs are queued and can sit at "not initiated" for minutes, far
			// longer than a widget call can wait, whereas the synchronous export
			// answers in about a second. It cannot join, so each document type is
			// three small reads joined here: the line items by SKU, then the
			// headers for just those documents, then the customer names.
			// Values come back as text ("USD 1,049.00", "Aug 07, 2026 00:00:00"),
			// so amounts and dates are parsed below.
			analyticsHeaders = Map();
			analyticsHeaders.put("ZANALYTICS-ORGID",ANALYTICS_ORG_ID);
			viewBase = "https://analyticsapi.zoho.com/restapi/v2/workspaces/" + ANALYTICS_WORKSPACE_ID + "/views/";
			customerView = "2604071000000006076";

			monthNumbers = Map();
			monthNumbers.put("Jan","01");
			monthNumbers.put("Feb","02");
			monthNumbers.put("Mar","03");
			monthNumbers.put("Apr","04");
			monthNumbers.put("May","05");
			monthNumbers.put("Jun","06");
			monthNumbers.put("Jul","07");
			monthNumbers.put("Aug","08");
			monthNumbers.put("Sep","09");
			monthNumbers.put("Oct","10");
			monthNumbers.put("Nov","11");
			monthNumbers.put("Dec","12");

			// Per document type: the Analytics views (item, header) and the column names.
			// Assigned explicitly rather than unpacked from a list: list.get(n) on a
			// split string was rejected by Deluge ("did not match ... [BIGINT]").
			docTypeNames = List();
			docTypeNames.add("Sales Order");
			docTypeNames.add("Sales Invoice");

			if(skuClause != "")
			{
				for each docTypeName in docTypeNames
				{
					docType = docTypeName;
					itemView = "2604071000000483529";
					itemTable = "Sales Order Items";
					headerView = "2604071000000483102";
					headerTable = "Sales Orders";
					idColumn = "Sales order ID";
					numberColumn = "Sales Order#";
					dateColumn = "Order Date";
					statusColumn = "Status";
					priceColumn = "Item Price (BCY)";
					discountColumn = "Discount Amount (FCY)";
					if(docTypeName == "Sales Invoice")
					{
						itemView = "2604071000000006080";
						itemTable = "Invoice Items";
						headerView = "2604071000000006079";
						headerTable = "Invoices";
						idColumn = "Invoice ID";
						numberColumn = "Invoice Number";
						dateColumn = "Invoice Date";
						statusColumn = "Invoice Status";
						priceColumn = "Item Price";
						discountColumn = "Discount Amount (BCY)";
					}
					stage = "start";
					try
					{
						// 1. the line items for these SKUs
						stage = "building the line request";
						lineColumns = List();
						lineColumns.add(idColumn);
						lineColumns.add("Item Name");
						lineColumns.add("Description");
						lineColumns.add("Quantity");
						lineColumns.add(priceColumn);
						lineColumns.add(discountColumn);
						lineColumns.add("Sub Total (BCY)");
						lineColumns.add("Total (BCY)");
						lineConfig = Map();
						lineConfig.put("responseFormat","json");
						lineConfig.put("selectedColumns",lineColumns);
						lineConfig.put("criteria","\"" + itemTable + "\".\"Item Name\" in (" + skuClause + ")");
						lineParams = Map();
						lineParams.put("CONFIG",lineConfig.toString());
						stage = "line request";
						lineResp = invokeurl
						[
							url :viewBase + itemView + "/data"
							type :GET
							parameters:lineParams
							headers:analyticsHeaders
							connection:"zohoanalytics"
						];
						stage = "line reply parse";
						lineNode = lineResp.get("data");
						// The rows sit at data (a list) or one level deeper at data.data,
						// depending on how the reply is wrapped. Which one is decided by
						// trying to read .data: a list rejects a text key, so it is kept as is.
						try
						{
							lineInner = lineNode.get("data");
							if(lineInner != null)
							{
								lineNode = lineInner;
							}
						}
						catch (unwrapError)
						{
						}
						if(lineNode == null)
						{
							warnings.add(docType + " lines could not be read from Analytics. Analytics replied: " + lineResp.toString());
							continue;
						}
						lineList = lineNode;
						if(lineList.size() == 0)
						{
							continue;
						}

						// 2. headers for just those documents, in batches of 100
						stage = "collecting document ids";
						docIds = List();
						for each lineRow in lineList
						{
							lineDocId = ifnull(lineRow.get(idColumn),"").toString();
							if(lineDocId != "" && !docIds.contains(lineDocId))
							{
								docIds.add(lineDocId);
							}
						}
						headerById = Map();
						customerIds = List();
						idBatch = List();
						idSeen = 0;
						for each docId in docIds
						{
							idBatch.add(docId);
							idSeen = idSeen + 1;
							if(idBatch.size() == 100 || idSeen == docIds.size())
							{
								stage = "header request";
								headerColumns = List();
								headerColumns.add(idColumn);
								headerColumns.add(numberColumn);
								headerColumns.add(dateColumn);
								headerColumns.add(statusColumn);
								headerColumns.add("Customer ID");
								headerConfig = Map();
								headerConfig.put("responseFormat","json");
								headerConfig.put("selectedColumns",headerColumns);
								idJoined = "";
								for each batchDocId in idBatch
								{
									if(idJoined != "")
									{
										idJoined = idJoined + ",";
									}
									idJoined = idJoined + batchDocId;
								}
								headerConfig.put("criteria","\"" + headerTable + "\".\"" + idColumn + "\" in (" + idJoined + ")");
								headerParams = Map();
								headerParams.put("CONFIG",headerConfig.toString());
								headerResp = invokeurl
								[
									url :viewBase + headerView + "/data"
									type :GET
									parameters:headerParams
									headers:analyticsHeaders
									connection:"zohoanalytics"
								];
								headerNode = headerResp.get("data");
								try
								{
									headerInner = headerNode.get("data");
									if(headerInner != null)
									{
										headerNode = headerInner;
									}
								}
								catch (unwrapError)
								{
								}
								if(headerNode == null)
								{
									warnings.add(docType + " headers could not be read from Analytics. Analytics replied: " + headerResp.toString());
								}
								stage = "header reply parse";
								for each headerRow in ifnull(headerNode,List())
								{
									headerId = ifnull(headerRow.get(idColumn),"").toString();
									if(headerId != "")
									{
										headerById.put(headerId,headerRow);
										headerCustomer = ifnull(headerRow.get("Customer ID"),"").toString();
										if(headerCustomer != "" && !customerIds.contains(headerCustomer))
										{
											customerIds.add(headerCustomer);
										}
									}
								}
								idBatch = List();
							}
						}

						// 3. customer names, in batches of 100
						nameById = Map();
						customerBatch = List();
						customerSeen = 0;
						for each customerId in customerIds
						{
							customerBatch.add(customerId);
							customerSeen = customerSeen + 1;
							if(customerBatch.size() == 100 || customerSeen == customerIds.size())
							{
								stage = "customer request";
								customerColumns = List();
								customerColumns.add("Customer ID");
								customerColumns.add("Customer Name");
								customerConfig = Map();
								customerConfig.put("responseFormat","json");
								customerConfig.put("selectedColumns",customerColumns);
								customerJoined = "";
								for each batchCustomerId in customerBatch
								{
									if(customerJoined != "")
									{
										customerJoined = customerJoined + ",";
									}
									customerJoined = customerJoined + batchCustomerId;
								}
								customerConfig.put("criteria","\"Customers\".\"Customer ID\" in (" + customerJoined + ")");
								customerParams = Map();
								customerParams.put("CONFIG",customerConfig.toString());
								customerResp = invokeurl
								[
									url :viewBase + customerView + "/data"
									type :GET
									parameters:customerParams
									headers:analyticsHeaders
									connection:"zohoanalytics"
								];
								customerNode = customerResp.get("data");
								try
								{
									customerInner = customerNode.get("data");
									if(customerInner != null)
									{
										customerNode = customerInner;
									}
								}
								catch (unwrapError)
								{
								}
								for each customerRow in ifnull(customerNode,List())
								{
									nameById.put(ifnull(customerRow.get("Customer ID"),"").toString(),ifnull(customerRow.get("Customer Name"),"").toString());
								}
								customerBatch = List();
							}
						}

						// 4. assemble the rows
						stage = "assembling rows";
						rowCount = 0;
						for each lineRow in lineList
						{
							if(rowCount >= MAX_ANALYTICS_ROWS)
							{
								warnings.add("Only the first " + MAX_ANALYTICS_ROWS + " " + docType.toLowerCase() + " lines were read from Analytics.");
								break;
							}
							headerRow = ifnull(headerById.get(ifnull(lineRow.get(idColumn),"").toString()),Map());
							lineSku = ifnull(lineRow.get("Item Name"),"").toString();

							docDate = "";
							// "Aug 07, 2026 00:00:00" -> "2026-08-07" by fixed positions
							dateText = ifnull(headerRow.get(dateColumn),"").toString().trim();
							if(dateText.length() >= 12)
							{
								monthNumber = ifnull(monthNumbers.get(dateText.subString(0,3)),"");
								if(monthNumber != "")
								{
									docDate = dateText.subString(8,12) + "-" + monthNumber + "-" + dateText.subString(4,6);
								}
							}

							quantityText = ifnull(lineRow.get("Quantity"),"0").toString().replaceAll("[^0-9.-]","");
							priceText = ifnull(lineRow.get(priceColumn),"0").toString().replaceAll("[^0-9.-]","");
							discountText = ifnull(lineRow.get(discountColumn),"0").toString().replaceAll("[^0-9.-]","");
							grossText = ifnull(lineRow.get("Sub Total (BCY)"),"0").toString().replaceAll("[^0-9.-]","");
							netText = ifnull(lineRow.get("Total (BCY)"),"0").toString().replaceAll("[^0-9.-]","");
							if(quantityText == "")
							{
								quantityText = "0";
							}
							if(priceText == "")
							{
								priceText = "0";
							}
							if(discountText == "")
							{
								discountText = "0";
							}
							if(grossText == "")
							{
								grossText = "0";
							}
							if(netText == "")
							{
								netText = "0";
							}

							bookRow = Map();
							bookRow.put("item_name",ifnull(codeToName.get(lineSku.toLowerCase()),lineSku));
							bookRow.put("description",ifnull(lineRow.get("Description"),""));
							bookRow.put("item_notes","");
							bookRow.put("doc_type",docType);
							bookRow.put("doc_number",ifnull(headerRow.get(numberColumn),""));
							bookRow.put("date",docDate);
							bookRow.put("account_name",ifnull(nameById.get(ifnull(headerRow.get("Customer ID"),"").toString()),""));
							bookRow.put("status",ifnull(headerRow.get(statusColumn),""));
							bookRow.put("quantity",quantityText.toDecimal());
							bookRow.put("item_price",priceText.toDecimal());
							bookRow.put("discount",discountText.toDecimal());
							bookRow.put("line_total",grossText.toDecimal());
							bookRow.put("total_after_discount",netText.toDecimal());
							rows.add(bookRow);
							rowCount = rowCount + 1;
						}
					}
					catch (e)
					{
						warnings.add(docType + " history could not be loaded from Analytics (stage: " + stage + "): " + e.toString());
					}
				}
			}
		}
	}
	else
	{
		warnings.add("No line items with a linked product were found, so there is nothing to build a history from.");
	}

	// ---- 5. make every free-text value safe to embed in JSON ------------
	// The response is assembled with Map.toString(), which does NOT escape
	// characters that are structural in JSON. Real ClearVista data trips this
	// constantly - inch marks in product names and quote subjects (65"
	// display, Sony 98" Panels) and hard line breaks in the multi-line
	// Description field would each produce output the widget cannot parse.
	// Rather than escaping, these characters are substituted with safe
	// equivalents, which keeps the text readable in the table: a double quote
	// becomes two apostrophes, which still reads as an inch mark (65'').
	// ------------------------------------------------------------
	textKeys = List();
	textKeys.add("item_name");
	textKeys.add("description");
	textKeys.add("item_notes");
	textKeys.add("doc_number");
	textKeys.add("account_name");
	textKeys.add("status");

	cleanRows = List();
	for each row in rows
	{
		for each textKey in textKeys
		{
			raw = ifnull(row.get(textKey),"").toString();
			raw = raw.replaceAll("\\\\","/");
			raw = raw.replaceAll("\"","''");
			raw = raw.replaceAll("\r"," ");
			raw = raw.replaceAll("\n"," ");
			raw = raw.replaceAll("\t"," ");
			row.put(textKey,raw.trim());
		}
		cleanRows.add(row);
	}

	cleanItems = List();
	for each item in items
	{
		cleanItem = item.toString();
		cleanItem = cleanItem.replaceAll("\\\\","/");
		cleanItem = cleanItem.replaceAll("\"","''");
		cleanItems.add(cleanItem.trim());
	}

	cleanWarnings = List();
	for each warning in warnings
	{
		cleanWarning = warning.toString();
		cleanWarning = cleanWarning.replaceAll("\\\\","/");
		cleanWarning = cleanWarning.replaceAll("\"","''");
		cleanWarning = cleanWarning.replaceAll("\r"," ");
		cleanWarning = cleanWarning.replaceAll("\n"," ");
		cleanWarning = cleanWarning.replaceAll("\t"," ");
		cleanWarnings.add(cleanWarning.trim());
	}

	quoteSubject = quoteSubject.replaceAll("\\\\","/");
	quoteSubject = quoteSubject.replaceAll("\"","''");
	quoteSubject = quoteSubject.replaceAll("\r"," ");
	quoteSubject = quoteSubject.replaceAll("\n"," ");
	quoteSubject = quoteSubject.replaceAll("\t"," ");
	quoteAccount = quoteAccount.replaceAll("\"","''");
	quoteNumber = quoteNumber.replaceAll("\"","''");

	quoteInfo = Map();
	quoteInfo.put("id",quoteRecordId);
	quoteInfo.put("quote_number",quoteNumber.trim());
	quoteInfo.put("subject",quoteSubject.trim());
	quoteInfo.put("account_name",quoteAccount.trim());

	result.put("success",true);
	result.put("quote",quoteInfo);
	result.put("items",cleanItems);
	result.put("rows",cleanRows);
	result.put("warnings",cleanWarnings);
	return result.toString();
}
