string automation.quote_item_history(String quote_id)
{
	// Backend for the Item History widget (launched from a sales quote).
	// Configure this function as: Return type String, argument quote_id (String).
	// The category word on line 1 must match this function's Category in CRM.
	//
	// Returns a JSON string: success, quote, items, rows, warnings.
	// item_price is the per-unit list price; total_after_discount is the
	// discounted EXTENDED total. The widget derives the per-unit price as
	// total_after_discount / quantity, because the stored item price is
	// sometimes a pre-discount list price (see CLAUDE.md).
	//
	// COQL connection: "crm_api_v21" - needs scope ZohoCRM.coql.READ, and is
	//   used to query the Quoted_Items subform module across all quotes. Deluge
	//   requires a LITERAL connection link name on an invokeurl, so if the
	//   connection is renamed, update both invokeurl blocks below by hand.
	// BOOKS_ORG_ID   - Zoho Books organization ID. Set it to "" to run against
	//                  CRM sales quotes only; the widget says so in a banner.
	// Neither failure is fatal - the widget renders whatever it could load.
	BOOKS_ORG_ID = "787402164";
	MAX_DOCS_PER_TYPE = 60;

	result = Map();
	rows = List();
	items = List();
	warnings = List();

	if(quote_id == null || quote_id.trim() == "")
	{
		result.put("success",false);
		result.put("message","Missing quote_id.");
		return result.toString();
	}
	quoteIdLong = quote_id.trim().toLong();

	// ---- 1. the quote this widget was launched from ---------------------
	quote = zoho.crm.getRecordById("Quotes",quoteIdLong);
	if(quote == null || !quote.containKey("id"))
	{
		result.put("success",false);
		result.put("message","Quote record " + quote_id + " could not be read.");
		return result.toString();
	}

	quoteNumber = ifnull(quote.get("CRM_Quote_Number"),"").toString();
	if(quoteNumber == "")
	{
		quoteNumber = ifnull(quote.get("Quote_Number"),quote_id).toString();
	}
	quoteAccount = "";
	if(quote.get("Account_Name") != null)
	{
		quoteAccount = ifnull(quote.get("Account_Name").get("name"),"").toString();
	}

	// ---- 2. the items on this quote drive the Item Name checklist --------
	productIds = List();
	skuById = Map();

	for each lineItem in ifnull(quote.get("Quoted_Items"),List())
	{
		product = lineItem.get("Product_Name");
		if(product == null)
		{
			continue;
		}
		productId = ifnull(product.get("id"),"").toString();
		sku = ifnull(product.get("name"),"").toString();
		if(productId == "" || sku == "")
		{
			continue;
		}
		if(!productIds.contains(productId))
		{
			productIds.add(productId);
			skuById.put(productId,sku);
		}
		if(!items.contains(sku))
		{
			items.add(sku);
		}
	}

	if(productIds.size() > 0)
	{
		idClause = "";
		for each productId in productIds
		{
			if(idClause != "")
			{
				idClause = idClause + ",";
			}
			idClause = idClause + "'" + productId + "'";
		}

		// ---- 3. CRM sales quote history (COQL over Quoted_Items) --------
		quoteLines = List();
		parentIds = List();
		crmLoaded = false;

		// Deluge has no while loop, so page through a fixed list of offsets.
		// 10 pages x 200 rows caps this at 2000 quote line items.
		pageOffsets = List();
		pageOffsets.add(0);
		pageOffsets.add(200);
		pageOffsets.add(400);
		pageOffsets.add(600);
		pageOffsets.add(800);
		pageOffsets.add(1000);
		pageOffsets.add(1200);
		pageOffsets.add(1400);
		pageOffsets.add(1600);
		pageOffsets.add(1800);

		try
		{
			morePages = true;
			for each pageOffset in pageOffsets
			{
				if(!morePages)
				{
					continue;
				}
				coql = "select Parent_Id, Product_Name, Description, Item_Notes, Quantity, List_Price, Discount, Total, Total_After_Discount from Quoted_Items where Product_Name in (" + idClause + ") limit " + pageOffset + ", 200";
				body = Map();
				body.put("select_query",coql);
				response = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:body.toString()
					connection:"crm_api_v21"
				];
				for each line in ifnull(response.get("data"),List())
				{
					quoteLines.add(line);
					parent = line.get("Parent_Id");
					if(parent != null)
					{
						parentId = ifnull(parent.get("id"),"").toString();
						if(parentId != "" && !parentIds.contains(parentId))
						{
							parentIds.add(parentId);
						}
					}
				}
				morePages = false;
				info = response.get("info");
				if(info != null && ifnull(info.get("more_records"),false) == true)
				{
					morePages = true;
				}
			}
			crmLoaded = true;
		}
		catch (e)
		{
			warnings.add("Sales quote history could not be loaded - check the crm_api_v21 connection: " + e.toString());
		}

		// ---- 3b. parent quote headers, in batches of 100 ----------------
		quoteHeaders = Map();
		if(crmLoaded && parentIds.size() > 0)
		{
			try
			{
				seen = 0;
				total = parentIds.size();
				batch = List();
				for each parentId in parentIds
				{
					batch.add(parentId);
					seen = seen + 1;
					if(batch.size() == 100 || seen == total)
					{
						batchClause = "";
						for each batchId in batch
						{
							if(batchClause != "")
							{
								batchClause = batchClause + ",";
							}
							batchClause = batchClause + "'" + batchId + "'";
						}
						headerCoql = "select id, CRM_Quote_Number, Quote_Stage, Account_Name, Date_created_on_document, Created_Time from Quotes where id in (" + batchClause + ") limit 0, 200";
						headerBody = Map();
						headerBody.put("select_query",headerCoql);
						headerResp = invokeurl
						[
							url :"https://www.zohoapis.com/crm/v7/coql"
							type :POST
							parameters:headerBody.toString()
							connection:"crm_api_v21"
						];
						for each record in ifnull(headerResp.get("data"),List())
						{
							recordId = ifnull(record.get("id"),"").toString();
							if(recordId == "")
							{
								continue;
							}
							documentDate = ifnull(record.get("Date_created_on_document"),"").toString();
							if(documentDate == "")
							{
								// Created_Time is an ISO timestamp - keep the date only.
								documentDate = ifnull(record.get("Created_Time"),"").toString();
								if(documentDate.length() >= 10)
								{
									documentDate = documentDate.subString(0,10);
								}
							}
							headerAccount = "";
							if(record.get("Account_Name") != null)
							{
								headerAccount = ifnull(record.get("Account_Name").get("name"),"").toString();
							}
							header = Map();
							header.put("quote_number",ifnull(record.get("CRM_Quote_Number"),"").toString());
							header.put("status",ifnull(record.get("Quote_Stage"),"").toString());
							header.put("account_name",headerAccount);
							header.put("date",documentDate);
							quoteHeaders.put(recordId,header);
						}
						batch = List();
					}
				}
			}
			catch (e)
			{
				warnings.add("Quote header details could not be loaded: " + e.toString());
			}
		}

		for each line in quoteLines
		{
			product = line.get("Product_Name");
			if(product == null)
			{
				continue;
			}
			lineSku = ifnull(product.get("name"),"").toString();
			parent = line.get("Parent_Id");
			parentId = "";
			parentName = "";
			if(parent != null)
			{
				parentId = ifnull(parent.get("id"),"").toString();
				parentName = ifnull(parent.get("name"),"").toString();
			}
			header = ifnull(quoteHeaders.get(parentId),Map());

			row = Map();
			row.put("item_name",lineSku);
			row.put("description",ifnull(line.get("Description"),""));
			row.put("item_notes",ifnull(line.get("Item_Notes"),""));
			row.put("doc_type","Sales Quote");
			row.put("doc_number",ifnull(header.get("quote_number"),parentName));
			row.put("date",ifnull(header.get("date"),""));
			row.put("account_name",ifnull(header.get("account_name"),""));
			row.put("status",ifnull(header.get("status"),""));
			row.put("quantity",ifnull(line.get("Quantity"),0));
			row.put("item_price",ifnull(line.get("List_Price"),0));
			row.put("discount",ifnull(line.get("Discount"),0));
			row.put("line_total",ifnull(line.get("Total"),0));
			row.put("total_after_discount",ifnull(line.get("Total_After_Discount"),0));
			rows.add(row);
		}

		// ---- 4. Zoho Books sales orders and invoices --------------------
		if(BOOKS_ORG_ID == "")
		{
			warnings.add("Zoho Books sales orders and invoices are not included: set BOOKS_ORG_ID in the quote_item_history function.");
		}
		else
		{
			booksModules = List();
			booksModules.add("SalesOrders");
			booksModules.add("Invoices");

			for each booksModule in booksModules
			{
				docType = "Sales Order";
				numberKey = "salesorder_number";
				idKey = "salesorder_id";
				if(booksModule == "Invoices")
				{
					docType = "Sales Invoice";
					numberKey = "invoice_number";
					idKey = "invoice_id";
				}

				for each productId in productIds
				{
					booksSku = ifnull(skuById.get(productId),"").toString();
					if(booksSku == "")
					{
						continue;
					}
					try
					{
						// Books item lookup by SKU - CRM Product_Name == Product_Code == SKU
						itemCriteria = Map();
						itemCriteria.put("name",booksSku);
						itemResp = zoho.books.getRecords("Items",BOOKS_ORG_ID,itemCriteria);
						booksItemId = "";
						for each booksItem in ifnull(itemResp.get("items"),List())
						{
							candidate = ifnull(booksItem.get("sku"),"").toString();
							if(candidate == "")
							{
								candidate = ifnull(booksItem.get("name"),"").toString();
							}
							if(candidate.equalsIgnoreCase(booksSku))
							{
								booksItemId = ifnull(booksItem.get("item_id"),"").toString();
								break;
							}
						}
						if(booksItemId == "")
						{
							continue;
						}

						// The item_id filter keeps the follow-up detail calls
						// bounded to documents that actually contain the item.
						docCriteria = Map();
						docCriteria.put("item_id",booksItemId);
						docCriteria.put("per_page",200);
						docResp = zoho.books.getRecords(booksModule,BOOKS_ORG_ID,docCriteria);
						docList = ifnull(docResp.get(booksModule.toLowerCase()),List());

						fetched = 0;
						for each doc in docList
						{
							if(fetched >= MAX_DOCS_PER_TYPE)
							{
								warnings.add("Only the " + MAX_DOCS_PER_TYPE + " most recent " + docType.toLowerCase() + "s were read for " + booksSku + ".");
								break;
							}
							docId = ifnull(doc.get(idKey),"").toString();
							if(docId == "")
							{
								continue;
							}
							detailResp = zoho.books.getRecordsByID(booksModule,BOOKS_ORG_ID,docId);
							detail = detailResp;
							if(detailResp.get("salesorder") != null)
							{
								detail = detailResp.get("salesorder");
							}
							else if(detailResp.get("invoice") != null)
							{
								detail = detailResp.get("invoice");
							}
							fetched = fetched + 1;

							for each booksLine in ifnull(detail.get("line_items"),List())
							{
								if(ifnull(booksLine.get("item_id"),"").toString() != booksItemId)
								{
									continue;
								}
								quantity = ifnull(booksLine.get("quantity"),0).toDecimal();
								rate = ifnull(booksLine.get("rate"),0).toDecimal();
								itemTotal = ifnull(booksLine.get("item_total"),0).toDecimal();
								gross = rate * quantity;
								discountAmount = gross - itemTotal;
								if(discountAmount < 0)
								{
									discountAmount = 0;
								}

								bookRow = Map();
								bookRow.put("item_name",booksSku);
								bookRow.put("description",ifnull(booksLine.get("description"),ifnull(booksLine.get("name"),"")));
								bookRow.put("item_notes","");
								bookRow.put("doc_type",docType);
								bookRow.put("doc_number",ifnull(detail.get(numberKey),""));
								bookRow.put("date",ifnull(detail.get("date"),""));
								bookRow.put("account_name",ifnull(detail.get("customer_name"),""));
								bookRow.put("status",ifnull(detail.get("status"),""));
								bookRow.put("quantity",quantity);
								bookRow.put("item_price",rate);
								bookRow.put("discount",discountAmount);
								bookRow.put("line_total",gross);
								bookRow.put("total_after_discount",itemTotal);
								rows.add(bookRow);
							}
						}
					}
					catch (e)
					{
						warnings.add(docType + " history for " + booksSku + " could not be loaded: " + e.toString());
					}
				}
			}
		}
	}
	else
	{
		warnings.add("This quote has no line items with a linked product, so there is nothing to build a history from.");
	}

	// ---- 5. make every free-text value safe to embed in JSON ------------ *
	// The response is assembled with Map.toString(), which does NOT escape
	// characters that are structural in JSON. Real ClearVista data trips this
	// constantly - inch marks in product names and quote subjects (65"
	// display, Sony 98" Panels) and hard line breaks in the multi-line
	// Description field would each produce output the widget cannot parse.
	// Rather than escaping, these characters are substituted with safe
	// equivalents, which keeps the text readable in the table: a double quote
	// becomes two apostrophes, which still reads as an inch mark (65'').
	// ------------------------------------------------------------
	textKeys = List();
	textKeys.add("item_name");
	textKeys.add("description");
	textKeys.add("item_notes");
	textKeys.add("doc_number");
	textKeys.add("account_name");
	textKeys.add("status");

	cleanRows = List();
	for each row in rows
	{
		for each textKey in textKeys
		{
			raw = ifnull(row.get(textKey),"").toString();
			raw = raw.replaceAll("\\\\","/");
			raw = raw.replaceAll("\"","''");
			raw = raw.replaceAll("\r"," ");
			raw = raw.replaceAll("\n"," ");
			raw = raw.replaceAll("\t"," ");
			row.put(textKey,raw.trim());
		}
		cleanRows.add(row);
	}

	cleanItems = List();
	for each item in items
	{
		cleanItem = item.toString();
		cleanItem = cleanItem.replaceAll("\\\\","/");
		cleanItem = cleanItem.replaceAll("\"","''");
		cleanItems.add(cleanItem.trim());
	}

	cleanWarnings = List();
	for each warning in warnings
	{
		cleanWarning = warning.toString();
		cleanWarning = cleanWarning.replaceAll("\\\\","/");
		cleanWarning = cleanWarning.replaceAll("\"","''");
		cleanWarning = cleanWarning.replaceAll("\r"," ");
		cleanWarning = cleanWarning.replaceAll("\n"," ");
		cleanWarning = cleanWarning.replaceAll("\t"," ");
		cleanWarnings.add(cleanWarning.trim());
	}

	quoteSubject = ifnull(quote.get("Subject"),"").toString();
	quoteSubject = quoteSubject.replaceAll("\\\\","/");
	quoteSubject = quoteSubject.replaceAll("\"","''");
	quoteSubject = quoteSubject.replaceAll("\r"," ");
	quoteSubject = quoteSubject.replaceAll("\n"," ");
	quoteSubject = quoteSubject.replaceAll("\t"," ");
	quoteAccount = quoteAccount.replaceAll("\"","''");
	quoteNumber = quoteNumber.replaceAll("\"","''");

	quoteInfo = Map();
	quoteInfo.put("id",quote_id);
	quoteInfo.put("quote_number",quoteNumber.trim());
	quoteInfo.put("subject",quoteSubject.trim());
	quoteInfo.put("account_name",quoteAccount.trim());

	result.put("success",true);
	result.put("quote",quoteInfo);
	result.put("items",cleanItems);
	result.put("rows",cleanRows);
	result.put("warnings",cleanWarnings);
	return result.toString();
}
